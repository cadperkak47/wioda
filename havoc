        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local afkBar = createUIElement("Frame", afkIntervalSlider, {
        Name = "Bar",
        Size = UDim2.new(1, -120, 1, 0),
        Position = UDim2.new(0, 110, 0, 0),
        BackgroundColor3 = Color3.fromRGB(30, 30, 60),
        BackgroundTransparency = 0,
        BorderColor3 = Color3.fromRGB(50, 40, 90),
        BorderThickness = 1,
    })

    local afkFill = createUIElement("Frame", afkBar, {
        Name = "Fill",
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(0, 200, 255),
        BackgroundTransparency = 0,
        BorderColor3 = Color3.fromRGB(0, 200, 255),
        BorderThickness = 1,
    })

    local uiKeyToggle = createUIElement("TextButton", miscGroup, {
        Name = "UIKey",
        Size = UDim2.new(1, 0, 0, 40),
        Position = UDim2.new(0, 10, 0, 100),
        BackgroundColor3 = Color3.fromRGB(25, 20, 40),
        BackgroundTransparency = 0.8,
        BorderColor3 = Color3.fromRGB(45, 35, 75),
        BorderThickness = 1,
        Text = "Custom UI Toggle Key",
        TextColor3 = Color3.fromRGB(200, 255, 255),
        TextSize = 16,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Toggle Logic
    local function createToggle(btn, prop, value)
        btn.MouseButton1Click:Connect(function()
            CONFIG[prop] = not CONFIG[prop]
            btn.TextColor3 = CONFIG[prop] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 230, 255)
            btn.BackgroundColor3 = CONFIG[prop] and Color3.fromRGB(30, 30, 60) or Color3.fromRGB(25, 20, 40)
            UIState.DeltaTime = 0
        end)
    end

    createToggle(afkToggle, "AntiAFK", CONFIG.AntiAFK)
    createToggle(uiKeyToggle, "UIKey", CONFIG.UIKey)

    -- Bind AFK Interval Slider
    local function bindAFKSlider()
        local bar = afkBar
        local fill = afkFill
        local value = afkValue
        local text = afkText

        afkIntervalSlider.MouseButton1Click:Connect(function()
            local mouse = UserInputService:GetMouseLocation()
            local localPos = mouse - bar.AbsolutePosition
            local percent = localPos.X / bar.AbsoluteSize.X
            local newInterval = math.floor(percent * 300) + 1
            newInterval = math.clamp(newInterval, 1, 300)

            fill.Size = UDim2.new(percent, 0, 1, 0)
            value.Text = tostring(newInterval)
            CONFIG.AFKInterval = newInterval
            UIState.DeltaTime = 0
        end)

        afkIntervalSlider.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                local mouse = UserInputService:GetMouseLocation()
                local localPos = mouse - bar.AbsolutePosition
                local percent = localPos.X / bar.AbsoluteSize.X
                local newInterval = math.floor(percent * 300) + 1
                newInterval = math.clamp(newInterval, 1, 300)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                value.Text = tostring(newInterval)
                CONFIG.AFKInterval = newInterval
            end
        end)
    end

    bindAFKSlider()

    return {
        AFKIntervalSlider = afkIntervalSlider,
        UIKeyToggle = uiKeyToggle,
        BindAFKSlider = bindAFKSlider,
    }
end

-- == RENDER LOOP (RenderStepped) ==
local function setupRenderLoop()
    local lastTime = tick()

    RunService.RenderStepped:Connect(function(dt)
        UIState.DeltaTime += dt

        -- Mouse Position
        UIState.Mouse = UserInputService:GetMouseLocation()

        -- Update DrawingImmediate
        local function updateDrawing(drawing, props)
            for k, v in pairs(props) do
                drawing[k] = v
            end
            return drawing
        end

        -- Aimbot FOV Circle
        local fovCircle = UIState.DrawingCache.fovCircle
        if fovCircle then
            fovCircle.Position = camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
            fovCircle.Radius = CONFIG.AimbotFOV
            fovCircle.Color = Color3.fromRGB(0, 200, 255)
            fovCircle.Thickness = 2
            fovCircle.Filled = false
            fovCircle.Alpha = 0.7
        end

        -- ESP
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= player and player.Character then
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local pos = camera:WorldToViewportPoint(root.Position)
                    local size = Vector2.new(100, 100) -- Example size
                    local x, y = pos.X, pos.Y
                    local w, h = size.X, size.Y

                    -- 2D Box
                    if CONFIG.ESP2DBox then
                        local box = UIState.DrawingCache["box_" .. player.UserId]
                        if not box then
                            box = createDrawing("Line", {
                                From = Vector2.new(x - w/2, y - h/2),
                                To = Vector2.new(x + w/2, y - h/2),
                                Color = Color3.fromRGB(200, 255, 255),
                                Thickness = 2,
                                Transparency = 0,
                            })
                            table.insert(UIState.DrawingCache, box)
                            UIState.DrawingCache["box_" .. player.UserId] = box
                        else
                            box.From = Vector2.new(x - w/2, y - h/2)
                            box.To = Vector2.new(x + w/2, y - h/2)
                            box.Color = Color3.fromRGB(200, 255, 255)
                            box.Thickness = 2
                        end

                        -- Top to bottom
                        local line1 = createDrawing("Line", {
                            From = Vector2.new(x + w/2, y - h/2),
                            To = Vector2.new(x + w/2, y + h/2),
                            Color = Color3.fromRGB(200, 255, 255),
                            Thickness = 2,
                            Transparency = 0,
                        })
                        table.insert(UIState.DrawingCache, line1)

                        -- Bottom to left
                        local line2 = createDrawing("Line", {
                            From = Vector2.new(x + w/2, y + h/2),
                            To = Vector2.new(x - w/2, y + h/2),
                            Color = Color3.fromRGB(200, 255, 255),
                            Thickness = 2,
                            Transparency = 0,
                        })
                        table.insert(UIState.DrawingCache, line2)

                        -- Left to top
                        local line3 = createDrawing("Line", {
                            From = Vector2.new(x - w/2, y + h/2),
                            To = Vector2.new(x - w/2, y - h/2),
                            Color = Color3.fromRGB(200, 255, 255),
                            Thickness = 2,
                            Transparency = 0,
                        })
                        table.insert(UIState.DrawingCache, line3)
                    end

                    -- Name
                    if CONFIG.ESPName then
                        local name = UIState.DrawingCache["name_" .. player.UserId]
                        if not name then
                            name = createDrawing("Text", {
                                Text = player.Name,
                                Size = 14,
                                Color = Color3.fromRGB(255, 255, 255),
                                OutlineColor = Color3.fromRGB(0, 0, 0),
                                Outline = true,
                                Position = Vector2.new(x - w/2, y - h/2 - 15),
                            })
                            UIState.DrawingCache["name_" .. player.UserId] = name
                        else
                            name.Text = player.Name
                            name.Position = Vector2.new(x - w/2, y - h/2 - 15)
                        end
                    end

                    -- Distance
                    if CONFIG.ESPDistance then
                        local dist = UIState.DrawingCache["dist_" .. player.UserId]
                        if not dist then
                            dist = createDrawing("Text", {
                                Text = string.format("%.1f", (root.Position - player.Character.HumanoidRootPart.Position).Magnitude),
                                Size = 12,
                                Color = Color3.fromRGB(180, 230, 255),
                                OutlineColor = Color3.fromRGB(0, 0, 0),
                                Outline = true,
                                Position = Vector2.new(x - w/2, y + h/2 + 5),
                            })
                            UIState.DrawingCache["dist_" .. player.UserId] = dist
                        else
                            dist.Text = string.format("%.1f", (root.Position - player.Character.HumanoidRootPart.Position).Magnitude)
                            dist.Position = Vector2.new(x - w/2, y + h/2 + 5)
                        end
                    end

                    -- Health Bar
                    if CONFIG.ESPHealthBar then
                        local health = UIState.DrawingCache["health_" .. player.UserId]
                        if not health then
                            health = createDrawing("Frame", {
                                Position = Vector2.new(x - w/2, y - h/2 - 20),
                                Size = Vector2.new(w, 5),
                                BackgroundColor = Color3.fromRGB(30, 30, 60),
                                BorderColor = Color3.fromRGB(100, 100, 140),
                                BorderThickness = 1,
                            })
                            UIState.DrawingCache["health_" .. player.UserId] = health
                        else
                            health.Position = Vector2.new(x - w/2, y - h/2 - 20)
                            health.Size = Vector2.new(w, 5)
                        end

                        local bar = UIState.DrawingCache["healthBar_" .. player.UserId]
                        if not bar then
                            bar = createDrawing("Frame", {
                                Position = Vector2.new(x - w/2, y - h/2 - 20),
                                Size = Vector2.new(w * (player.Character.Humanoid.Health / player.Character.Humanoid.MaxHealth), 5),
                                BackgroundColor = Color3.fromRGB(0, 200, 255),
                                BorderColor = Color3.fromRGB(0, 200, 255),
                                BorderThickness = 1,
                            })
                            UIState.DrawingCache["healthBar_" .. player.UserId] = bar
                        else
                            bar.Size = Vector2.new(w * (player.Character.Humanoid.Health / player.Character.Humanoid.MaxHealth), 5)
                        end
                    end
                end
            end
        end

        -- Skeleton ESP
        if CONFIG.SkeletonESP then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= player and player.Character then
                    local root = player.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local joints = {
                            "Head",
                            "Left Arm",
                            "Right Arm",
                            "Left Leg",
                            "Right Leg",
                        }

                        for _, jointName in ipairs(joints) do
                            local joint = player.Character:FindFirstChild(jointName)
                            if joint then
                                local jointPos = camera:WorldToViewportPoint(joint.Position)
                                local rootPos = camera:WorldToViewportPoint(root.Position)

                                local line = UIState.DrawingCache["skeleton_" .. player.UserId .. "_" .. jointName]
                                if not line then
                                    line = createDrawing("Line", {
                                        From = rootPos,
                                        To = jointPos,
                                        Color = Color3.fromRGB(200, 255, 255),
                                        Thickness = 2,
                                        Transparency = 0,
                                    })
                                    UIState.DrawingCache["skeleton_" .. player.UserId .. "_" .. jointName] = line
                                else
                                    line.From = rootPos
                                    line.To = jointPos
                                end
                            end
                        end
                    end
                end
            end
        end

        -- Chams
        if CONFIG.ChamsEnabled then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= player and player.Character then
                    local chams = UIState.DrawingCache["chams_" .. player.UserId]
                    if not chams then
                        chams = Instance.new("Highlight")
                        chams.FillColor = Color3.fromRGB(0, 200, 255)
                        chams.OutlineColor = Color3.fromRGB(0, 200, 255)
                        chams.OutlineTransparency = 0
                        chams.FillTransparency = 0.4
                        chams.AlwaysOnTop = true
                        chams.Enabled = true
                        chams.Parent = player.Character
                        UIState.DrawingCache["chams_" .. player.UserId] = chams
                    else
                        chams.FillColor = Color3.fromRGB(0, 200, 255)
                        chams.OutlineColor = Color3.fromRGB(0, 200, 255)
                        chams.OutlineTransparency = 0
                        chams.FillTransparency = 0.4
                    end
                end
            end
        end

        -- Tracers
        if CONFIG.TracerEnabled then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= player and player.Character then
                    local root = player.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local pos = camera:WorldToViewportPoint(root.Position)
                        local tracer = UIState.DrawingCache["tracer_" .. player.UserId]
                        if not tracer then
                            tracer = createDrawing("Line", {
                                From = Vector2.new(pos.X, camera.ViewportSize.Y),
                                To = Vector2.new(pos.X, pos.Y),
                                Color = Color3.fromRGB(0, 200, 255),
                                Thickness = 1,
                                Transparency = 0.5,
                            })
                            UIState.DrawingCache["tracer_" .. player.UserId] = tracer
                        else
                            tracer.From = Vector2.new(pos.X, camera.ViewportSize.Y)
                            tracer.To = Vector2.new(pos.X, pos.Y)
                        end
                    end
                end
            end
        end

        -- World Mods
        if CONFIG.WorldMods.FullBright then
            Lighting.Brightness = 5
        else
            Lighting.Brightness = 1
        end

        Lighting.ClockTime = CONFIG.WorldMods.ClockTime

        if CONFIG.WorldMods.NoFog then
            Lighting.FogEnd = math.huge
            Lighting.FogStart = 0
        else
            Lighting.FogEnd = 100
            Lighting.FogStart = 50
        end

        lastTime = tick()
    end)
end

-- == HEARTBEAT LOOP (Movement, AFK, Aimbot, etc.) ==
local function setupHeartbeatLoop()
    local lastTick = tick()

    RunService.Heartbeat:Connect(function(dt)
        -- Movement
        if CONFIG.WalkSpeed then
            humanoid.WalkSpeed = CONFIG.WalkSpeed
        end

        if CONFIG.JumpPower then
            humanoid.JumpPower = CONFIG.JumpPower
        end

        if CONFIG.FlyEnabled then
            local bodyVelocity = character:FindFirstChild("BodyVelocity")
            if not bodyVelocity then
                bodyVelocity = Instance.new("BodyVelocity")
                bodyVelocity.MaxForce = Vector3.new(9999, 9999, 9999)
                bodyVelocity.Velocity = Vector3.new(0, 0, 0)
                bodyVelocity.Parent = character
            end

            local input = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then input += Vector3.new(0, 0, -1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then input += Vector3.new(0, 0, 1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then input += Vector3.new(-1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then input += Vector3.new(1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then input += Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then input += Vector3.new(0, -1, 0) end

            input = input.unit * CONFIG.FlySpeed
            bodyVelocity.Velocity = input
        end

        if CONFIG.NoclipEnabled then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end

        if CONFIG.InfiniteJump then
            humanoid:Jump()
            if humanoid:GetState() == Enum.HumanoidStateType.Jumping then
                humanoid.JumpPower = CONFIG.JumpPower
            end
        end

        -- AFK
        if CONFIG.AntiAFK then
            if tick() - lastTick > CONFIG.AFKInterval then
                local mouse = UserInputService:GetMouseLocation()
                if (mouse - UIState.LastMouse).Magnitude > CONFIG.AFKActionThreshold then
                    UserInputService:SendMouseMoveEvent(mouse.X, mouse.Y)
                else
                    UserInputService:SendMouseWheelEvent(0, 0, 1)
                end
                lastTick = tick()
            end
        end

        -- Aimbot
        local closest = nil
        local minDist = math.huge

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= player and player.Character then
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local pos = camera:WorldToViewportPoint(root.Position)
                    local dist = (pos - camera.ViewportSize / 2).Magnitude
                    if dist < minDist and dist < CONFIG.AimbotFOV then
                        minDist = dist
                        closest = player
                    end
                end
            end
        end

        if closest and minDist < CONFIG.AimbotFOV then
            local target = closest.Character.HumanoidRootPart
            local targetPos = camera:WorldToViewportPoint(target.Position)
            local aimPos = targetPos

            -- Add micro-jitter
            aimPos += Vector2.new(math.random(-2, 2), math.random(-2, 2))

            -- Smooth aim
            local current = camera.CFrame
            local targetCFrame = CFrame.lookAt(camera.CFrame.Position, target.Position)
            local lerpFactor = CONFIG.AimbotSmoothness * UIState.DeltaTime

            local newCFrame = current:Lerp(targetCFrame, lerpFactor)
            camera.CFrame = newCFrame

            -- Silent Aim
            if CONFIG.SilentAim then
                pcall(function()
                    VirtualInputManager:SendMouseClick(Vector2.new(aimPos.X, aimPos.Y), 1)
                end)
            end

            -- Triggerbot
            if CONFIG.Triggerbot then
                local target = closest.Character.HumanoidRootPart
                local pos = camera:WorldToViewportPoint(target.Position)
                local dist = (pos - camera.ViewportSize / 2).Magnitude
                if dist < CONFIG.AimbotFOV then
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(1, 1, 0, 0, 0)
                        wait(CONFIG.TriggerbotDelay)
                        VirtualInputManager:SendMouseButtonEvent(1, 0, 0, 0, 0)
                    end)
                end
            end

            -- Auto-Fire
            if CONFIG.AutoFire then
                local target = closest.Character.HumanoidRootPart
                local pos = camera:WorldToViewportPoint(target.Position)
                local dist = (pos - camera.ViewportSize / 2).Magnitude
                if dist < CONFIG.AimbotFOV then
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(1, 1, 0, 0, 0)
                        wait(CONFIG.AutoFireDelay)
                        VirtualInputManager:SendMouseButtonEvent(1, 0, 0, 0, 0)
                    end)
                end
            end
        end

        UIState.LastMouse = UIState.Mouse
    end)
end

