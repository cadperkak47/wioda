-- == UTILITIES ==
local function createDrawing(type, props)
    local drawing = DrawingLibrary.new(type)
    for k, v in pairs(props) do
        drawing[k] = v
    end
    return drawing
end

local function createUIElement(elementType, parent, props)
    local element = Instance.new(elementType)
    for k, v in pairs(props) do
        -- FIX: Roblox UI elements use BorderSizePixel, not BorderThickness
        if k == "BorderThickness" then
            element.BorderSizePixel = v
        else
            element[k] = v
        end
    end
    element.Parent = parent
    return element
end

local function createTween(element, properties, duration, easeStyle)
    local tweenInfo = TweenInfo.new(duration, easeStyle or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    return TweenService:Create(element, tweenInfo, properties)
end

local function updateUIStroke(element, color, thickness)
    element.StrokeColor = color
    element.StrokeTransparency = 0
    element.StrokeThickness = thickness
end

local function updateUICorner(element, radius)
    element.CornerRadius = UDim.new(0, radius)
end

