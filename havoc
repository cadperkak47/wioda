-- == FEATURE: TAB SWITCHING ==
local function setupTabSwitching(menu)
    local tabs = menu.Tabs

    for name, data in pairs(tabs) do
        local btn = data.Button
        local label = data.Label
        local glow = data.Glow

        btn.MouseEnter:Connect(function()
            local tween = createTween(glow, { BackgroundTransparency = 0.2 }, 0.3, Enum.EasingStyle.Quad)
            tween:Play()
        end)

        btn.MouseLeave:Connect(function()
            local tween = createTween(glow, { BackgroundTransparency = 0.5 }, 0.3, Enum.EasingStyle.Quad)
            tween:Play()
        end)

        btn.MouseButton1Click:Connect(function()
            -- Fade out current tab
            for tName, tData in pairs(tabs) do
                local tween = createTween(tData.Label, { TextColor3 = Color3.fromRGB(180, 230, 255) }, 0.2, Enum.EasingStyle.Quad)
                tween:Play()
                tData.Glow.Visible = false
            end

            -- Activate new tab
            local tween = createTween(label, { TextColor3 = Color3.fromRGB(255, 255, 255) }, 0.2, Enum.EasingStyle.Quad)
            tween:Play()
            glow.Visible = true

            UIState.ActiveTab = name
            UIState.DeltaTime = 0
        end)
    end

    -- Close Button
    menu.CloseBtn.MouseButton1Click:Connect(function()
        menu.Frame.Visible = false
        UIState.MenuOpen = false
    end)

    -- Top Bar Drag
    menu.TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            UIState.Dragging = true
            UIState.DragOffset = Vector2.new(
                menu.Frame.AbsolutePosition.X - UserInputService:GetMouseLocation().X,
                menu.Frame.AbsolutePosition.Y - UserInputService:GetMouseLocation().Y
            )
        end
    end)

    menu.TopBar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            UIState.Dragging = false
        end
    end)

    -- Drag Logic
    UserInputService.InputChanged:Connect(function(input, gameProcessed)
        if UIState.Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mouse = UserInputService:GetMouseLocation()
            local pos = Vector2.new(mouse.X + UIState.DragOffset.X, mouse.Y + UIState.DragOffset.Y)
            menu.Frame.Position = UDim2.new(0, pos.X, 0, pos.Y)
        end
    end)
end

