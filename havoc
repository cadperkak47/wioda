-- == RENDER LOOP (RenderStepped) ==
local function setupRenderLoop()
    RunService.RenderStepped:Connect(function(dt)
        UIState.DeltaTime += dt
        UIState.Mouse = UserInputService:GetMouseLocation()

        -- ESP Logic (Fixed to check if target is NOT LocalPlayer)
        for _, targetPlayer in pairs(Players:GetPlayers()) do
            if targetPlayer ~= player and targetPlayer.Character then
                local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local screenPos, onScreen = camera:WorldToViewportPoint(root.Position)
                    
                    if onScreen then
                        local w, h = 50, 100 
                        local x, y = screenPos.X, screenPos.Y

                        -- 2D Box (Memory Leak Fixed)
                        if CONFIG.ESP2DBox then
                            if not UIState.DrawingCache["box_" .. targetPlayer.UserId] then
                                UIState.DrawingCache["box_" .. targetPlayer.UserId] = {
                                    top = createDrawing("Line", {Color = Color3.fromRGB(0, 200, 255), Thickness = 1}),
                                    bottom = createDrawing("Line", {Color = Color3.fromRGB(0, 200, 255), Thickness = 1}),
                                    left = createDrawing("Line", {Color = Color3.fromRGB(0, 200, 255), Thickness = 1}),
                                    right = createDrawing("Line", {Color = Color3.fromRGB(0, 200, 255), Thickness = 1}),
                                }
                            end
                            
                            local box = UIState.DrawingCache["box_" .. targetPlayer.UserId]
                            box.top.From = Vector2.new(x - w/2, y - h/2)
                            box.top.To = Vector2.new(x + w/2, y - h/2)
                            
                            box.bottom.From = Vector2.new(x - w/2, y + h/2)
                            box.bottom.To = Vector2.new(x + w/2, y + h/2)
                            
                            box.left.From = Vector2.new(x - w/2, y - h/2)
                            box.left.To = Vector2.new(x - w/2, y + h/2)
                            
                            box.right.From = Vector2.new(x + w/2, y - h/2)
                            box.right.To = Vector2.new(x + w/2, y + h/2)
                        end

                        -- Name
                        if CONFIG.ESPName then
                            if not UIState.DrawingCache["name_" .. targetPlayer.UserId] then
                                UIState.DrawingCache["name_" .. targetPlayer.UserId] = createDrawing("Text", {
                                    Size = 14, Color = Color3.fromRGB(255, 255, 255), Outline = true
                                })
                            end
                            local name = UIState.DrawingCache["name_" .. targetPlayer.UserId]
                            name.Text = targetPlayer.Name
                            name.Position = Vector2.new(x - w/2, y - h/2 - 15)
                        end
                    else
                        -- Hide if off-screen
                        if UIState.DrawingCache["box_" .. targetPlayer.UserId] then
                            local box = UIState.DrawingCache["box_" .. targetPlayer.UserId]
                            box.top.From = Vector2.new(0,0); box.top.To = Vector2.new(0,0)
                            box.bottom.From = Vector2.new(0,0); box.bottom.To = Vector2.new(0,0)
                            box.left.From = Vector2.new(0,0); box.left.To = Vector2.new(0,0)
                            box.right.From = Vector2.new(0,0); box.right.To = Vector2.new(0,0)
                        end
                        if UIState.DrawingCache["name_" .. targetPlayer.UserId] then
                            UIState.DrawingCache["name_" .. targetPlayer.UserId].Position = Vector2.new(0,0)
                        end
                    end
                end
            end
        end
    end)
end

-- == HEARTBEAT LOOP (Movement, AFK, Aimbot, etc.) ==
local function setupHeartbeatLoop()
    local lastTick = tick()

    RunService.Heartbeat:Connect(function(dt)
        if humanoid then
            humanoid.WalkSpeed = CONFIG.WalkSpeed
            humanoid.JumpPower = CONFIG.JumpPower
        end

        if CONFIG.FlyEnabled then
            local bodyVelocity = character:FindFirstChild("BodyVelocity")
            if not bodyVelocity then
                bodyVelocity = Instance.new("BodyVelocity")
                bodyVelocity.MaxForce = Vector3.new(9999, 9999, 9999)
                bodyVelocity.Velocity = Vector3.new(0, 0, 0)
                bodyVelocity.Parent = character
            end

            local input = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then input += Vector3.new(0, 0, -1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then input += Vector3.new(0, 0, 1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then input += Vector3.new(-1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then input += Vector3.new(1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then input += Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then input += Vector3.new(0, -1, 0) end

            input = input.Unit * CONFIG.FlySpeed
            bodyVelocity.Velocity = input
        else
            local bodyVelocity = character:FindFirstChild("BodyVelocity")
            if bodyVelocity then bodyVelocity:Destroy() end
        end

        if CONFIG.NoclipEnabled then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end

        if CONFIG.InfiniteJump and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end

        if CONFIG.AntiAFK then
            if tick() - lastTick > CONFIG.AFKInterval then
                VirtualInputManager:SendMouseMoveEvent(100, 100, game)
                lastTick = tick()
            end
        end

        -- Aimbot (Fixed Logic)
        local closest = nil
        local minDist = math.huge

        for _, targetPlayer in pairs(Players:GetPlayers()) do
            if targetPlayer ~= player and targetPlayer.Character then
                local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local pos, onScreen = camera:WorldToViewportPoint(root.Position)
                    local dist = (Vector2.new(pos.X, pos.Y) - camera.ViewportSize / 2).Magnitude
                    if onScreen and dist < minDist and dist < CONFIG.AimbotFOV then
                        minDist = dist
                        closest = targetPlayer
                    end
                end
            end
        end

        if closest and minDist < CONFIG.AimbotFOV then
            local target = closest.Character.HumanoidRootPart
            local current = camera.CFrame
            local targetCFrame = CFrame.lookAt(current.Position, target.Position)
            
            -- Fix Lerp calculation
            local lerpFactor = math.clamp(CONFIG.AimbotSmoothness * (dt * 60), 0, 1)
            camera.CFrame = current:Lerp(targetCFrame, lerpFactor)

            -- Triggerbot / Auto-Fire (Fixed VirtualInputManager)
            if CONFIG.Triggerbot or CONFIG.AutoFire then
                task.spawn(function()
                    VirtualInputManager:SendMouseButtonEvent(camera.ViewportSize.X/2, camera.ViewportSize.Y/2, 0, true, game, 0)
                    task.wait(CONFIG.TriggerbotDelay)
                    VirtualInputManager:SendMouseButtonEvent(camera.ViewportSize.X/2, camera.ViewportSize.Y/2, 0, false, game, 0)
                end)
            end
        end
    end)
end

-- == MAIN EXECUTION ==
local function main()
    local menu = setupMenu()
    setupCombat(menu)
    setupVisuals(menu)
    
    -- Setup Rendering & Heartbeat
    setupRenderLoop()
    setupHeartbeatLoop()

    menu.Frame.Visible = true

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.KeyCode == CONFIG.UIKey then
            menu.Frame.Visible = not menu.Frame.Visible
            UIState.MenuOpen = menu.Frame.Visible
        end
    end)

    -- Initialize FOV Circle (Fixed Vector2 issue)
    local fovCircle = createDrawing("Circle", {
        Radius = CONFIG.AimbotFOV,
        Color = Color3.fromRGB(0, 200, 255),
        Thickness = 2,
        Filled = false,
    })
    
    -- Keep FOV circle at center of screen
    RunService.RenderStepped:Connect(function()
        if fovCircle then
            fovCircle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        end
    end)

    print("✅ Havoc | Potassium Exploit Loaded Successfully")
end

main()
